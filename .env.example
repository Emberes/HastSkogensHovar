# Kopiera till .env.local (ignoreras av git) och lägg in samma värde
# hos webbhotellet/Vercel under miljövariabler.
#
# SHA-256-hash av admin-lösenordet (inte lösenordet i klartext). Skapa den i
# PowerShell, byt ut DittLösenord:
#   $b=[Text.Encoding]::UTF8.GetBytes('DittLösenord'); -join ([Security.Cryptography.SHA256]::Create().ComputeHash($b) | % { $_.ToString('x2') })
#
# OBS: tillfällig inloggning utan backend. Hashen hamnar i webbläsarens kod,
# så den skyddar inget hemligt. Använd inte ett lösenord som används någon
# annanstans.
VITE_ADMIN_PASSWORD_HASH=
